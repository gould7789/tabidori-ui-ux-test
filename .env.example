# ─────────────────────────────────────────────────────────────
# .env.example → .env 로 복사해서 값을 채운다. .env는 git에 올리지 않는다(.gitignore).
# ─────────────────────────────────────────────────────────────

# [Google Maps Platform] 지도(Maps JavaScript API) + 이동시간(Routes API)에 같이 쓰는 키
#  - 지도용으로는 페이지 소스에 그대로 보인다 → 콘솔에서 API 제한(Maps JavaScript API, Routes API만 허용)을 걸어둘 것
#  - HTTP 리퍼러 제한을 걸면 서버의 Routes API 호출이 거부된다 → 그때는 아래 BROWSER/SERVER 키로 나눌 것
GOOGLE_MAPS_API_KEY=

# (선택) 키를 나눌 때만. 값이 있으면 위 공용 키보다 우선한다
#  - BROWSER: 리퍼러 제한 http://localhost:8000/* , http://127.0.0.1:8000/*
#  - SERVER : 리퍼러 제한 없이 Routes API만 허용
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=

# (선택) 지도 ID — 핀(AdvancedMarker)에 필요. 비우면 개발용 DEMO_MAP_ID
GOOGLE_MAPS_MAP_ID=

# 1 = Routes API 호출(결과는 .cache/routes.json에 저장해 재호출 안 함), 0 = 고정값만
USE_ROUTES_API=1

# ── 아래는 이 화면에서는 아직 안 쓴다(Agent 연결 시 사용 예정) ──
# [Anthropic] Claude API — 어드바이저 대화(LangGraph Agent)
ANTHROPIC_API_KEY=
# [LangSmith] LangGraph 실행 추적
LANGSMITH_API_KEY=
# [RapidAPI] 외부 API 호출용
X_Rapidapi_Key=
